# Puerto interno del contenedor
PORT=8080
HOST=0.0.0.0

# Ruta de la base SQLite. En Docker/NaN debe apuntar al volumen persistente.
DB_PATH=/data/basket-playbook.db

# Secreto de sesión. Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-esto-por-un-secreto-largo

# open | invite
REGISTRATION_MODE=open
INVITE_CODE=

# 1 cuando la app se sirve por HTTPS (NaN Apps). 0 en localhost HTTP.
COOKIE_SECURE=0
